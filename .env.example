# ==============================================================================
# TEMPLATE ENV UNTUK DEPLOY DI HOME SERVER (DOCKER)
# Salin file ini menjadi `.env` di folder root sebelum menjalankan docker-compose.
# ==============================================================================

# 1. Ganti 192.168.1.100 dengan IP lokal Home Server Anda (atau domain lokal Anda)
#    IP ini digunakan agar browser di perangkat lain (HP, laptop) bisa menghubungi backend.
HOME_SERVER_IP=192.168.1.100

# 2. URL Backend API yang akan diakses oleh browser/client
#    Next.js memerlukan variabel ini saat build time (pembuatan docker image).
NEXT_PUBLIC_API_URL=https://medium-api.muji-rahman.site

# 3. URL Situs (untuk OG Image generation dan SEO)
NEXT_PUBLIC_SITE_URL=https://medium.muji-rahman.site

# 4. Origin frontend yang diizinkan oleh CORS backend (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGINS=http://localhost:3000,https://medium.muji-rahman.site

# 5. Kunci rahasia JWT (Sangat disarankan diganti dengan string acak yang panjang di produksi)
JWT_SECRET=super_secret_jwt_key_ubah_ini_di_productionqwertyuiopasdfghjkl0987654erfghjkbvczxcv0987654wdfghjnbfde34567uikjn

# ==============================================================================
# MinIO Object Storage (Self-Hosted)
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=medium-uploads

# URL publik untuk akses gambar dari browser
# Untuk Cloudflare Tunnel, gunakan: https://medium-storage.muji-rahman.site
MINIO_PUBLIC_URL=https://medium-storage.muji-rahman.site
